# PRP AI Assistant Environment Configuration
# Copy this file to .env and set appropriate values

# === REQUIRED SECRETS (Generate with: openssl rand -hex 32) ===
SECRET_KEY=your_32_character_secret_key_here
JWT_SECRET_KEY=your_32_character_jwt_secret_here

# === ENVIRONMENT ===
PRP_ENV=development
PORT=8000

# === DATABASE CONFIGURATION ===
DATABASE_URL=postgresql://username:password@localhost:5432/prp_dev

# Database Pool Settings (production tuning)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false

# === REDIS CONFIGURATION ===
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# === ANALYTICS SETTINGS ===
ANALYTICS_RETENTION_DAYS=90
MAX_PRP_COMPLEXITY=10
DEFAULT_SUCCESS_THRESHOLD=0.8

# === FEATURE FLAGS ===
ENABLE_PREDICTIVE_ANALYSIS=true
ENABLE_SECURITY_SCANNING=true
ENABLE_PERFORMANCE_MONITORING=true

# === EXTERNAL SERVICES ===
CLAUDE_API_KEY=your_claude_api_key_here
GITHUB_TOKEN=your_github_token_here

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === WORKER CONFIGURATION ===
CELERY_CONCURRENCY=4
WEB_CONCURRENCY=4

# === CORS SETTINGS ===
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2

# === SECURITY HEADERS ===
FORCE_HTTPS=true
SECURITY_HEADERS_ENABLED=true

# === MONITORING ===
MONITORING_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_TIMEOUT=30

# === TESTING (for test environment) ===
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/prp_test
TEST_REDIS_URL=redis://localhost:6379/1