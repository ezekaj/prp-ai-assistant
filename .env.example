# PRP AI Assistant - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Settings
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
PRP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/prp_system
POSTGRES_DB=prp_system
POSTGRES_USER=prpuser
POSTGRES_PASSWORD=secure_password_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Worker Configuration
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=2

# Analytics Settings
ANALYTICS_RETENTION_DAYS=90
MAX_PRP_COMPLEXITY=10
DEFAULT_SUCCESS_THRESHOLD=0.8

# Feature Flags
ENABLE_PREDICTIVE_ANALYSIS=true
ENABLE_SECURITY_SCANNING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ANALYTICS=true
ENABLE_METRICS=true

# External Integrations
CLAUDE_API_KEY=your-claude-api-key
GITHUB_TOKEN=your-github-token

# Monitoring & Observability
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
LOG_LEVEL=INFO
LOG_FORMAT=json

# Testing (for test environment)
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/prp_test
TEST_REDIS_URL=redis://localhost:6379/1

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Backup & Maintenance
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
CLEANUP_INTERVAL=24